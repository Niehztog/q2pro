# Ground Zero (Rogue) game library.
# Ported from the last official rogue source release, with q2pro's
# baseq2 history replayed on top.  See doc/mission-packs.md.

# m_move2.c is an unused alternative copy of m_move.c; Ground Zero's own
# Makefile does not build it either, and linking both duplicates symbols.
rogue_src = files(
  'dm_ball.c',
  'dm_tag.c',
  'g_ai.c',
  'g_chase.c',
  'g_cmds.c',
  'g_combat.c',
  'g_func.c',
  'g_items.c',
  'g_main.c',
  'g_misc.c',
  'g_monster.c',
  'g_newai.c',
  'g_newdm.c',
  'g_newfnc.c',
  'g_newtarg.c',
  'g_newtrig.c',
  'g_newweap.c',
  'g_phys.c',
  'g_ptrs.c',
  'g_save.c',
  'g_spawn.c',
  'g_sphere.c',
  'g_svcmds.c',
  'g_target.c',
  'g_trigger.c',
  'g_turret.c',
  'g_utils.c',
  'g_weapon.c',
  'm_actor.c',
  'm_berserk.c',
  'm_boss2.c',
  'm_boss3.c',
  'm_boss31.c',
  'm_boss32.c',
  'm_brain.c',
  'm_carrier.c',
  'm_chick.c',
  'm_flipper.c',
  'm_float.c',
  'm_flyer.c',
  'm_gladiator.c',
  'm_gunner.c',
  'm_hover.c',
  'm_infantry.c',
  'm_insane.c',
  'm_medic.c',
  'm_move.c',
  'm_mutant.c',
  'm_parasite.c',
  'm_soldier.c',
  'm_stalker.c',
  'm_supertank.c',
  'm_tank.c',
  'm_turret.c',
  'm_widow.c',
  'm_widow2.c',
  'p_client.c',
  'p_hud.c',
  'p_trail.c',
  'p_view.c',
  'p_weapon.c',
)

shared_library('game' + cpu, rogue_src + game_shared_src,
  name_prefix:           '',
  dependencies:          game_deps,
  include_directories:   engine_inc,
  gnu_symbol_visibility: 'hidden',
  link_args:             dll_link_args,
  install:               system_wide,
  install_dir:           libdir / 'rogue',
  override_options:      get_option('game-build-options'),
)
